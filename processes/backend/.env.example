NODE_ENV=development
HOST=127.0.0.1
PORT=4317
DATABASE_URL=postgresql://wecode:wecode@127.0.0.1:55432/wecode
REDIS_URL=redis://127.0.0.1:56379
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=replace-with-at-least-32-random-characters
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
INSTALLATION_ID=local-desktop
LOG_LEVEL=info
WORKER_CONCURRENCY=2
PROXY_PROBE_URL=https://example.com/
# External destinations are configured by the operator, never inferred from email content.

# Playwright engine. Install the matching browser with npm run browser:install.
BROWSER_POOL_SIZE=2
BROWSER_HEADLESS=true
BROWSER_CHANNEL=chromium
BROWSER_ACQUIRE_TIMEOUT_MS=30000
BROWSER_LEASE_SECONDS=120
BROWSER_ACTION_TIMEOUT_MS=15000
BROWSER_NAVIGATION_TIMEOUT_MS=30000
BROWSER_EXECUTION_TIMEOUT_MS=300000
BROWSER_SESSION_TTL_SECONDS=259200
# Optional absolute directory; default is local OS application-data/WeCode/automation/INSTALLATION_ID.
# BROWSER_DATA_DIR=D:/WeCodeData/profiles
# Separate, disposable test databases. Apply migrations before running tests.
# TEST_DATABASE_URL=postgresql://wecode:wecode@127.0.0.1:55432/wecode_test
# TEST_ENGINE_DATABASE_URL=postgresql://wecode:wecode@127.0.0.1:55432/wecode_engine_test
# TEST_BROWSER_CHANNEL=chrome

# Observed verification sender in signup.har; override only for a confirmed provider change.
WEVERSE_OTP_SENDER=noreply@weverse.io
