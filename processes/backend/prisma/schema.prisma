generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
}
enum TaskStatus {
 DRAFT
 QUEUED
 RUNNING
 PAUSE_REQUESTED
 PAUSED
 SUCCEEDED
 FAILED
 BLOCKED
 NEEDS_RECONCILIATION
}
enum BusinessOutcome {
 NOT_CREATED
 CREATED
 UNKNOWN
}
model Task {
 id String @id @default(uuid()) @db.Uuid
 name String @db.VarChar(120)
 workflow String @default("create-account") @db.VarChar(40)
 status TaskStatus @default(DRAFT)
 desiredState String @default("paused") @map("desired_state")
 config Json
 emailConfigId String? @map("email_config_id") @db.Uuid
 emailConfig EmailConfig? @relation(fields:[emailConfigId],references:[id],onDelete:Restrict)
 version Int @default(1)
 attemptCount Int @default(0) @map("attempt_count")
 currentRunId String? @map("current_run_id") @db.Uuid
 createKey String? @unique @map("create_key") @db.VarChar(128)
 requestHash String? @map("request_hash")
 deletedAt DateTime? @map("deleted_at")
 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime @updatedAt @map("updated_at")
 currentRun TaskRun? @relation("CurrentRun",fields:[currentRunId],references:[id],onDelete:SetNull)
 runs TaskRun[] @relation("TaskRuns")
 @@index([status,createdAt])
 @@map("tasks")
}
model TaskRun {
 id String @id @default(uuid()) @db.Uuid
 taskId String @map("task_id") @db.Uuid
 task Task @relation("TaskRuns",fields:[taskId],references:[id],onDelete:Restrict)
 attempt Int
 status TaskStatus @default(QUEUED)
 outcome BusinessOutcome @default(NOT_CREATED)
 retryable Boolean @default(false)
 errorCode String? @map("error_code")
 checkpoint Json?
 leaseToken String? @map("lease_token") @db.Uuid
 heartbeatAt DateTime? @map("heartbeat_at")
 startedAt DateTime? @map("started_at")
 finishedAt DateTime? @map("finished_at")
 createdAt DateTime @default(now()) @map("created_at")
 currentFor Task[] @relation("CurrentRun")
 accounts Account[]
 outbox OutboxEvent?
 @@unique([taskId,attempt])
 @@index([status,heartbeatAt])
 @@map("task_runs")
}
model Account {
 id String @id @default(uuid()) @db.Uuid
 email String @unique @db.VarChar(254)
 username String @db.VarChar(80)
 passwordCipher String @map("password_cipher")
 proxyUsed String? @map("proxy_used") @db.VarChar(512)
 status String @default("created") @db.VarChar(32)
 taskRunId String? @map("task_run_id") @db.Uuid
 taskRun TaskRun? @relation(fields:[taskRunId],references:[id],onDelete:Restrict)
 createdAt DateTime @default(now()) @map("created_at")
 sessions Session[]
 @@index([status,createdAt,id])
 @@map("accounts")
}
model Proxy {
 id String @id @default(uuid()) @db.Uuid
 protocol String @db.VarChar(8)
 host String @db.VarChar(253)
 port Int
 usernameCipher String? @map("username_cipher")
 passwordCipher String? @map("password_cipher")
 fingerprint String @unique @db.VarChar(64)
 status String @default("unknown") @db.VarChar(24)
 enabled Boolean @default(true)
 totalUses Int @default(0) @map("total_uses")
 lastUsedAt DateTime? @map("last_used_at")
 createdAt DateTime @default(now()) @map("created_at")
 capacity Int @default(1)
 assignments ProxyAssignment[]
 profiles BrowserProfile[]
 health ProxyHealth[]
 @@index([enabled,status,lastUsedAt])
 @@map("proxies")
}
model ProxyHealth {
 id String @id @default(uuid()) @db.Uuid
 proxyId String @map("proxy_id") @db.Uuid
 proxy Proxy @relation(fields:[proxyId],references:[id],onDelete:Cascade)
 healthy Boolean
 latencyMs Int? @map("latency_ms")
 errorCode String? @map("error_code")
 checkedAt DateTime @default(now()) @map("checked_at")
 @@index([proxyId,checkedAt])
 @@map("proxy_health")
}
model EmailConfig {
 id String @id @default(uuid()) @db.Uuid
 inboxAddress String @map("inbox_address") @db.VarChar(254)
 accountDomain String? @map("account_domain") @db.VarChar(253)
 mailbox String @default("INBOX") @db.VarChar(128)
 appPasswordCipher String @map("app_password_cipher")
 host String @db.VarChar(253)
 port Int @default(993)
 status String @default("unknown") @db.VarChar(24)
 version Int @default(1)
 lastCheckedAt DateTime? @map("last_checked_at")
 createdAt DateTime @default(now()) @map("created_at")
 tasks Task[]
 verifications VerificationRequest[]
 @@map("email_configs")
}
model VerificationRequest {
 id String @id @default(uuid()) @db.Uuid
 emailConfigId String @map("email_config_id") @db.Uuid
 emailConfig EmailConfig @relation(fields:[emailConfigId],references:[id],onDelete:Restrict)
 mailbox String @default("INBOX") @db.VarChar(128)
 recipient String @db.VarChar(254)
 sender String @db.VarChar(254)
 requestedAt DateTime @default(now()) @map("requested_at")
 expiresAt DateTime @map("expires_at")
 status String @default("waiting") @db.VarChar(24)
 codeCipher String? @map("code_cipher")
 uid String?
 uidValidity String? @map("uid_validity")
 @@unique([emailConfigId,mailbox,uidValidity,uid])
 @@index([status,expiresAt])
 @@map("verification_requests")
}
model Session {
 id String @id @default(uuid()) @db.Uuid
 accountId String @map("account_id") @db.Uuid
 account Account @relation(fields:[accountId],references:[id],onDelete:Cascade)
 profileId String? @map("profile_id") @db.Uuid
 profile BrowserProfile? @relation(fields:[profileId],references:[id],onDelete:SetNull)
 payloadCipher String @map("payload_cipher")
 expiresAt DateTime @map("expires_at")
 revokedAt DateTime? @map("revoked_at")
 createdAt DateTime @default(now()) @map("created_at")
 @@index([accountId,expiresAt])
 @@map("sessions")
}
model Log {
 id BigInt @id @default(autoincrement())
 level String @db.VarChar(12)
 category String @db.VarChar(32)
 event String @db.VarChar(100)
 entityId String? @map("entity_id")
 metadata Json
 createdAt DateTime @default(now()) @map("created_at")
 @@index([category,createdAt])
 @@map("logs")
}
model OutboxEvent {
 id String @id @default(uuid()) @db.Uuid
 runId String @unique @map("run_id") @db.Uuid
 run TaskRun @relation(fields:[runId],references:[id],onDelete:Restrict)
 publishedAt DateTime? @map("published_at")
 createdAt DateTime @default(now()) @map("created_at")
 @@index([publishedAt,createdAt])
 @@map("outbox_events")
}

model BrowserProfile {
 id String @id @default(uuid()) @db.Uuid
 installationId String @map("installation_id") @db.VarChar(64)
 name String @db.VarChar(120)
 mode String @default("isolated") @db.VarChar(16)
 state String @default("idle") @db.VarChar(24)
 assignedProxyId String? @map("assigned_proxy_id") @db.Uuid
 assignedProxy Proxy? @relation(fields:[assignedProxyId],references:[id],onDelete:Restrict)
 ownerRunId String? @map("owner_run_id") @db.Uuid
 ownerToken String? @map("owner_token") @db.Uuid
 leaseExpiresAt DateTime? @map("lease_expires_at")
 stateCipher String? @map("state_cipher")
 stateVersion Int @default(0) @map("state_version")
 lastActivityAt DateTime @default(now()) @map("last_activity_at")
 browserVersion String? @map("browser_version")
 deletedAt DateTime? @map("deleted_at")
 createdAt DateTime @default(now()) @map("created_at")
 sessions Session[]
 @@unique([installationId,name])
 @@index([installationId,state])
 @@map("browser_profiles")
}
model ProxyAssignment {
 id String @id @default(uuid()) @db.Uuid
 proxyId String @map("proxy_id") @db.Uuid
 proxy Proxy @relation(fields:[proxyId],references:[id],onDelete:Restrict)
 runId String @map("run_id") @db.Uuid
 ownerToken String @map("owner_token") @db.Uuid
 leaseExpiresAt DateTime @map("lease_expires_at")
 releasedAt DateTime? @map("released_at")
 releaseReason String? @map("release_reason") @db.VarChar(40)
 createdAt DateTime @default(now()) @map("created_at")
 @@index([proxyId,releasedAt])
 @@index([runId,ownerToken])
 @@map("proxy_assignments")
}
